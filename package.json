{
  "name": "cocarr-platform-web",
  "private": true,
  "version": "1.0.0",
  "description": "Cocarr platform frontend — three independently deployed apps over one set of shared packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:admin": "turbo run dev --filter=@cocarr/admin-web",
    "dev:workspace": "turbo run dev --filter=@cocarr/workspace-web",
    "dev:operations": "turbo run dev --filter=@cocarr/operations-web",
    "build:admin": "turbo run build --filter=@cocarr/admin-web",
    "build:workspace": "turbo run build --filter=@cocarr/workspace-web",
    "build:operations": "turbo run build --filter=@cocarr/operations-web",
    "dev:legacy": "next dev",
    "build:legacy": "next build",
    "start:legacy": "next start",
    "lint:legacy": "next lint",
    "start:admin": "npm run start --workspace=@cocarr/admin-web",
    "start:workspace": "npm run start --workspace=@cocarr/workspace-web",
    "start:operations": "npm run start --workspace=@cocarr/operations-web"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "^41.4.2",
    "@ckeditor/ckeditor5-react": "^9.5.0",
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-google-maps/api": "^2.20.6",
    "@reduxjs/toolkit": "^2.6.1",
    "@rpldy/upload-button": "^1.9.1",
    "@rpldy/uploady": "^1.9.1",
    "@splidejs/react-splide": "^0.7.12",
    "@tanstack/react-table": "^8.21.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@tiptap/react": "^2.11.7",
    "@tiptap/starter-kit": "^2.11.7",
    "axios": "^1.8.4",
    "chart.js": "^4.4.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.6.0",
    "lucide-react": "^0.487.0",
    "moment": "^2.30.1",
    "next": "^15.2.8",
    "rc-slider": "^11.1.8",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-cropper": "^2.3.3",
    "react-date-range": "^2.0.1",
    "react-datepicker": "^8.2.1",
    "react-day-picker": "^9.6.5",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.0.7",
    "react-redux": "^9.2.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.5.0",
    "react-scripts": "^5.0.1",
    "react-select": "^5.10.1",
    "react-toastify": "^11.0.5",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "web-vitals": "^4.2.4",
    "yet-another-react-lightbox": "^3.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.17",
    "eslint": "^9",
    "eslint-config-next": "^15.2.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "turbo": "^2.3.3"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  }
}
