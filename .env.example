# =============================================================================
# cocarr-platform-web — environment variables
# Copy to .env.local for local dev; set in the Railway service for production.
#
# IMPORTANT: every NEXT_PUBLIC_* value is INLINED AT BUILD TIME. Changing one
# requires a rebuild, and each panel is its own build/deploy (see below).
# =============================================================================

# --- Which panel this build/deploy is ----------------------------------------
# One of: root | admin | ops | support | finance | growth | developer
# Defaults to 'admin' if unset. Determines nav, modules and privileges shipped.
NEXT_PUBLIC_PANEL=admin

# --- API base for apps/* (admin-web, workspace-web, operations-web) ----------
# REQUIRED. @cocarr/api-sdk resolves every service from this ONE value
# (/v1/core, /v1/platform, /v1/workspace, ...), and @cocarr/shared-utils
# photoUrl() builds image URLs from the same place.
#
# LEAVING THIS UNSET BREAKS IMAGES FIRST AND MOST VISIBLY: baseUrlFor() throws,
# photoUrl() has no host to build against, and every <img> gets an empty src —
# which looks like missing data, not missing config. The console says so
# explicitly; check there before hunting the image.
#
# Point it at the GATEWAY, not the legacy monolith:
#   apis-dev.cocarr.com  = platform gateway (this one)
#   api-dev.cocarr.com   = LEGACY monolith  (no 's' — different system)
NEXT_PUBLIC_GATEWAY_URL=https://apis-dev.cocarr.com

# --- API base for the LEGACY single app under src/app/ ------------------------
# Only src/app/** reads these. Unlike the apps above, this one wants the full
# base INCLUDING /v1 — and against the gateway that means the /v1/core prefix,
# or the image proxy and every call 404s.
NEXT_PUBLIC_BASE_URL=https://apis-dev.cocarr.com/v1/core
REACT_APP_BASE_URL=https://apis-dev.cocarr.com/v1/core
REACT_APP_UPLOAD_URL=https://apis-dev.cocarr.com/v1/core/image

# --- Workspace API base (cocarr-workspace-api) -------------------------------
# Used by the Workspace panel's screens. Defaults to http://localhost:3040/v1.
NEXT_PUBLIC_WORKSPACE_API_URL=https://workspace-api.cocarr.com/v1

# --- Firebase (ADMIN project — public client config, safe to expose) ---------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Cross-panel host map (for hostFor() links between split panels) ---------
NEXT_PUBLIC_HOST_ROOT=https://root.cocarr.com
NEXT_PUBLIC_HOST_ADMIN=https://admin.cocarr.com
NEXT_PUBLIC_HOST_OPS=https://ops.cocarr.com
NEXT_PUBLIC_HOST_SUPPORT=https://support.cocarr.com
NEXT_PUBLIC_HOST_FINANCE=https://finance.cocarr.com
NEXT_PUBLIC_HOST_GROWTH=https://growth.cocarr.com
NEXT_PUBLIC_HOST_DEVELOPER=https://developer.cocarr.com
NEXT_PUBLIC_HOST_WORKSPACE=https://workspace.cocarr.com

# --- Panel key mode (see COCARR-ADMIN CLAUDE.md "panel key") -----------------
# Direct mode: browser sends this key (inlined, replayable — a speed bump).
NEXT_PUBLIC_PANEL_KEY=
# Gateway mode: route through this app's own /api/panel with a SERVER-ONLY key.
NEXT_PUBLIC_PANEL_GATEWAY=false
PANEL_KEY=                                  # server-only (NOT NEXT_PUBLIC) — never inlined
PANEL_GATEWAY_TARGET=https://apis-dev.cocarr.com/v1/core
